# Disable TLS support (plain TCP mode)
CONFIG_TLS_ENABLE=n

# Use custom partition table
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# Network Interface - Ethernet (ESP32-P4-Module-DEV-KIT)
CONFIG_NETWORK_INTERFACE_ETHERNET=y

# Enable internal Ethernet MAC
CONFIG_ETH_USE_ESP32_EMAC=y

# Ethernet PHY Configuration - IP101 GRI
CONFIG_ETH_PHY_IP101=y
CONFIG_ETH_PHY_ADDR=1

# Ethernet Management Interface Pins
CONFIG_ETH_MDC_GPIO=31
CONFIG_ETH_MDIO_GPIO=52
CONFIG_ETH_PHY_RST_GPIO=51

# Ethernet RMII Data Interface Pins
CONFIG_ETH_RMII_TX_EN_GPIO=49
CONFIG_ETH_RMII_TXD0_GPIO=34
CONFIG_ETH_RMII_TXD1_GPIO=35
CONFIG_ETH_RMII_RXD0_GPIO=29
CONFIG_ETH_RMII_RXD1_GPIO=30
CONFIG_ETH_RMII_CRS_DV_GPIO=28
CONFIG_ETH_RMII_REF_CLK_GPIO=50

# UART Bridge Configuration
CONFIG_ENABLE_UART_BRIDGES=4
